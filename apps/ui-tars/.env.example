# Copy to .env and fill locally. Never commit .env.
# Voice (Qwen Realtime)
QWEN_API_KEY=
QWEN_WORKSPACE_ID=
QWEN_MODEL=qwen3.8-omni-flash-realtime
# Optional: override the Realtime WebSocket URL and voice. Token Plan keys use
# a dedicated endpoint; Qwen Audio 3.x uses voices such as "longanqian".
# Token Plan example:
#   QWEN_MODEL=qwen-audio-3.0-realtime-plus
#   QWEN_VOICE=longanqian
#   QWEN_REALTIME_URL=wss://token-plan.maas.qianwenaiapi.com/api-ws/v1/realtime?model=qwen-audio-3.0-realtime-plus
QWEN_REALTIME_URL=
QWEN_VOICE=
# Optional: local WAV used by the dev-only "test audio" IPC
CYRVIS_TEST_WAV=

# Local stop-word barge-in (sherpa-onnx). Defaults resolve to
# ../../../models/kws/... and ../../../models/voiceprint/... from apps/ui-tars.
# CYRVIS_KWS_MODEL_DIR=
# CYRVIS_KWS_KEYWORDS=
# CYRVIS_VOICEPRINT_MODEL=
# CYRVIS_VOICEPRINT_EMBEDDING=
# Mixed speaker audio needs a lower threshold than clean enrollment audio.
# Bare "停" uses max(this, 0.25); multi-syllable words use min(this, 0.20).
CYRVIS_KWS_VOICEPRINT_THRESHOLD=0.22
# KWS score threshold. Lower = more recall for a short bare "停". Self-echo is
# handled by the TTS-text gate, so this can be very low.
CYRVIS_KWS_THRESHOLD=0.05
# Ignore repeated detections of the same word within this window.
CYRVIS_KWS_COOLDOWN_MS=800
# If the voiceprint extractor itself fails, allow multi-syllable stop words
# (停一下/别说了) but keep bare "停" behind verification. Set 0 to fail closed.
CYRVIS_KWS_ALLOW_UNVERIFIED_MULTI=1
# A/B comparison: startup default for the 11:00 1500/180ms energy-only barge.
# Press Ctrl+Alt+E at runtime to toggle between energy-only and KWS+voiceprint.
# Set 0 to start in the echo-safe KWS+voiceprint mode.
CYRVIS_EXTERNAL_ENERGY_BARGE=0
# Dump the last 3s of raw mic audio when KWS/voiceprint rejects a stop word.
# Files land in doc/kws-lab/ for offline replay.
CYRVIS_KWS_DUMP_FAILURES=1

# Optional GUI VLM defaults (normally configured in the app settings UI).
# Plan key uses the /api/plan/v3 base URL; standard pay-as-you-go uses /api/v3.
VLM_PROVIDER=
VLM_API_KEY=
VLM_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
VLM_MODEL_NAME=doubao-seed-2.1-lite
